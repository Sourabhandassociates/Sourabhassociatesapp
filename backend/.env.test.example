NODE_ENV=test
PORT=4001

# A separate database from dev/prod — the test suite truncates every table before each test.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/saa_law_firm_test?schema=public"

# Same 32-char minimum as .env.example — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_32_CHARS_MINIMUM_TEST_ONLY
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS_MINIMUM_TEST_ONLY_DIFFERENT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
MFA_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM_TEST_ONLY_DIFFERENT_2

CLIENT_ID_PREFIX=SA-CLI-
MATTER_NUMBER_PREFIX=SA-MAT-

UPLOAD_DIR=./uploads-test

CORS_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax
