PORT=4000
NODE_ENV=development

# PostgreSQL connection - update credentials for your local instance
# DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/saa_law_firm?schema=public"
DATABASE_URL="postgresql://postgres:SourabhAssoc_2026!@localhost:5432/saa_law_firm?schema=public"

# JWT secrets - REQUIRED, must each be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the same value for both, and never commit real values.
JWT_ACCESS_SECRET=CHANGE_ME_32_CHARS_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS_MINIMUM_DIFFERENT_FROM_ACCESS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# MFA (Version 1.0 Milestone 4) - encrypts each user's TOTP secret at rest. Same
# generation command and 32-char minimum as the JWT secrets above; must differ from both.
MFA_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM_DIFFERENT_FROM_JWT_SECRETS

# Firm ID numbering
CLIENT_ID_PREFIX=SA-CLI-
MATTER_NUMBER_PREFIX=SA-MAT-

# Local document storage (Phase 1 - cloud storage comes later)
UPLOAD_DIR=./uploads

# Comma-separated list of origins allowed to call this API (the Web Admin Portal's
# dev/prod URL(s)). Never use "*" — CORS is a real access boundary, not decoration.
CORS_ORIGIN=http://localhost:5173

# Refresh-token cookie SameSite policy: "strict" if the Web Admin Portal and this API
# are ever served from the exact same site (recommended); "lax" if the dev setup spans
# different localhost ports (still same-site, works fine); "none" ONLY if they end up on
# genuinely different sites in production — and only ever over HTTPS if so.
COOKIE_SAME_SITE=lax
